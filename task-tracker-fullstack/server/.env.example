# Copy this file to ".env" for local work. On Vercel, add the same names in
# Project Settings > Environment Variables.

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD]. Do NOT add ?sslmode=... at the end.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put-the-service-role-key-here   # secret! server only, never in the client

JWT_SECRET=put-a-long-random-text-here
PORT=4000
APP_TIMEZONE=Asia/Manila

# Optional: send the "forgot password" email with Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Task Tracker <onboarding@resend.dev>
APP_URL=https://your-app.vercel.app

# Only needed if the React app is hosted on a different website than the API.
CORS_ORIGIN=

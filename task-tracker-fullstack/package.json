{
  "name": "task-tracker-fullstack",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": { "concurrently": "^9.0.0" }
}
